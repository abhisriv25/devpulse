{
  "name": "devpulse",
  "private": true,
  "workspaces": [
    "devpulse-backend",
    "devpulse-frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=devpulse-backend",
    "dev:web": "npm run dev --workspace=devpulse-frontend",
    "db:migrate": "npm run db:migrate --workspace=devpulse-backend",
    "db:generate": "npm run db:generate --workspace=devpulse-backend"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
